{
  "hosting": {
    "site": "f3qsource",
    "public": ".",
    "ignore": [
      "firebase.json",
      "scripts/**",
      "content/**",
      "sources/**",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/2021",
        "destination": "/2017/",
        "type": 301
      },
      {
        "source": "/2021/:rest*",
        "destination": "/2017/:rest*",
        "type": 301
      }
    ]
  }
}
